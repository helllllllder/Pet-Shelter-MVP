    {
      "type": "text",
      "id": "text_outcome_root",
      "x": 1060,
      "y": 158,
      "width": 760,
      "height": 104,
      "text": "\ud83c\udfaf PRIMARY DESIRED OUTCOME (BRD v3.0)\nZero Lost Medical Records & 40% Admin Overhead Reduction\nvia Reliable Offline-First Multi-Shelter Operations\n(KPI-01: Retrieval <30s | KPI-02: Waste -80% | KPI-03: Compliance 95% |\nKPI-04: 0 Lost Records | KPI-05: Admin -40%)",
      "originalText": "\ud83c\udfaf PRIMARY DESIRED OUTCOME (BRD v3.0)\nZero Lost Medical Records & 40% Admin Overhead Reduction\nvia Reliable Offline-First Multi-Shelter Operations\n(KPI-01: Retrieval <30s | KPI-02: Waste -80% | KPI-03: Compliance 95% |\nKPI-04: 0 Lost Records | KPI-05: Admin -40%)",
